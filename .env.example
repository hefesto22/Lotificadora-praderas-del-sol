# ─────────────────────────────────────────────────────────────────
# APLICACIÓN — Residencial Praderas del Sol
# Sistema de Gestión Inmobiliaria y Control de Lotificaciones
# ─────────────────────────────────────────────────────────────────
APP_NAME="Praderas del Sol"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://lotificadora-praderas-del-sol.test
APP_TIMEZONE=America/Tegucigalpa

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_HN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Identificador único del proyecto — usado como prefijo de Redis,
# nombre de contenedores Docker y branding del panel admin.
APP_SLUG=praderas
APP_BRAND_NAME="${APP_NAME}"

# ─────────────────────────────────────────────────────────────────
# LOGGING — stack JSON + Sentry para errores en producción
# ─────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=daily,sentry
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─────────────────────────────────────────────────────────────────
# BASE DE DATOS — PostgreSQL 18 (§7.1 regla de paridad)
# ─────────────────────────────────────────────────────────────────
# Puerto 5442 (NO 5432): los otros proyectos Olympo en esta Mac ya
# ocupan el puerto estándar. Dev y test comparten contenedor y
# versión de motor, pero jamás la misma base (§7.2).
# SQLite está PROHIBIDO en tests — un test verde en SQLite que falla
# en Postgres da confianza falsa sobre CHECK, JSONB, CTE y NUMERIC.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5442
DB_DATABASE=praderas_dev
DB_USERNAME=postgres
DB_PASSWORD=
DB_SCHEMA=public

# Base de pruebas. La crea el script de init de Docker en el primer
# arranque del contenedor. `pest --parallel` genera además
# praderas_test_1..N, por eso el rol necesita CREATEDB.
DB_DATABASE_TEST=praderas_test

# ─────────────────────────────────────────────────────────────────
# REDIS 8 — cache, sesión, queue y locks distribuidos
# ─────────────────────────────────────────────────────────────────
# Puerto 6389 (NO 6379) por la misma razón que Postgres.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6389
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_PREFIX="${APP_SLUG}_"

# ─────────────────────────────────────────────────────────────────
# CACHE / SESSION / QUEUE — todos sobre Redis en producción
# ─────────────────────────────────────────────────────────────────
# Prefijos explícitos: Laravel 13 cambió los defaults de "_cache_"
# a "-cache-". Fijarlos aquí evita que un upgrade invalide todas
# las keys en caliente.
CACHE_STORE=redis
CACHE_PREFIX="${APP_SLUG}_cache"

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# En producción va en true. Sin esto la cookie de sesión viaja también por
# HTTP y se puede robar desde cualquier red abierta.
SESSION_SECURE_COOKIE=false

QUEUE_CONNECTION=redis
HORIZON_DOMAIN=
HORIZON_PATH=horizon
HORIZON_PREFIX="${APP_SLUG}_horizon:"

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ─────────────────────────────────────────────────────────────────
# CORREO
# ─────────────────────────────────────────────────────────────────
# TODO: dominio real de envío al cerrar ADR-0003 (infraestructura).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@grupoolympo.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─────────────────────────────────────────────────────────────────
# ALMACENAMIENTO S3-COMPATIBLE — para backups y archivos grandes
# ─────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── Respaldos y alertas ────────────────────────────────────────────────
# Discos donde queda el respaldo, separados por coma. `local` SOLO alcanza en
# desarrollo: un respaldo en el mismo disco que la base no es un respaldo.
BACKUP_DISKS=local
# Contraseña del zip. Sin ella, el respaldo es la base de datos completa
# legible por cualquiera que tenga acceso al servidor.
BACKUP_ARCHIVE_PASSWORD=
# Alertas de salud: base caída, disco lleno, cron muerto, respaldo viejo.
HEALTH_NOTIFICATIONS=true
HEALTH_ALERT_EMAIL=

# ─────────────────────────────────────────────────────────────────
# OBSERVABILIDAD — Sentry
# ─────────────────────────────────────────────────────────────────
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
SENTRY_SEND_DEFAULT_PII=false

# ─────────────────────────────────────────────────────────────────
# BROWSERSHOT — generación de PDFs vía Chromium headless
# ─────────────────────────────────────────────────────────────────
# En Herd/macOS local: deja vacíos, Browsershot autodetecta.
# En producción Linux: rutas absolutas a chromium-browser y node.
BROWSERSHOT_CHROME_PATH=
BROWSERSHOT_NODE_PATH=
BROWSERSHOT_NO_SANDBOX=false

# ─────────────────────────────────────────────────────────────────
# SUPER-ADMIN INICIAL — consumido por AdminUserSeeder
# ─────────────────────────────────────────────────────────────────
# Credenciales por defecto en DESARROLLO LOCAL: admin@gmail.com / 12345678
# OBLIGATORIO cambiar ADMIN_PASSWORD antes de deployar a producción.
# Si ADMIN_PASSWORD está vacío en producción, el seeder FALLA.
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=12345678
ADMIN_NAME="Administrador"

# ─────────────────────────────────────────────────────────────────
# DOCKER COMPOSE — variables consumidas por docker-compose.yml
# ─────────────────────────────────────────────────────────────────
# Literal, NO "${APP_SLUG}": esta variable la consume docker compose,
# no Laravel. Si la interpolación del .env fallara, el nombre de
# proyecto quedaría en el string crudo y compose aborta.
COMPOSE_PROJECT_NAME=praderas
COMPOSE_POSTGRES_PORT=5442
COMPOSE_REDIS_PORT=6389
COMPOSE_POSTGRES_PASSWORD=
# trust = sin password, SOLO desarrollo local (el puerto está en 127.0.0.1).
# En cualquier entorno compartido: scram-sha-256 + COMPOSE_POSTGRES_PASSWORD.
COMPOSE_POSTGRES_AUTH=trust

# ─────────────────────────────────────────────────────────────────
# VITE
# ─────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"

# ── Suspension por mora (Clausula Septima) ──────────────────────────────
# En true corta el acceso al panel y a los documentos, y muestra el aviso de
# pago. NO borra datos y NO bloquea al super-admin: la Clausula Decima obliga
# a poder exportarle todo al cliente aunque este suspendido.
PRADERAS_SUSPENDIDO=false
