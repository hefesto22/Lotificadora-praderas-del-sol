# ═══════════════════════════════════════════════════════════════════════
#  PLANTILLA PARA EL SERVIDOR — no es la de desarrollo
# ═══════════════════════════════════════════════════════════════════════
#
#  `.env.example` sirve para levantar el proyecto en una Mac. Copiado tal
#  cual a un servidor deja APP_DEBUG=true, la contraseña 12345678 y Postgres
#  en `trust`. Esta plantilla existe para que eso no pase por distracción.
#
#  Se copia como `.env`, se llenan los <marcadores>, y después:
#      php artisan olympo:verificar-produccion
#  Ese comando NO se puede saltear: es lo único que atrapa lo que falla en
#  silencio.
# ═══════════════════════════════════════════════════════════════════════

APP_NAME="<Nombre del cliente>"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<dominio-del-cliente>
APP_SLUG=<slug>
APP_TIMEZONE=America/Tegucigalpa
APP_LOCALE=es

LOG_CHANNEL=daily
LOG_LEVEL=warning

# ─── Base de datos ─────────────────────────────────────────────────────
# CON contraseña. El VPS es compartido con otros proyectos de Olympo.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=<base>
DB_USERNAME=<usuario>
DB_PASSWORD=<contraseña larga>

# ─── Redis ─────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=<contraseña larga>

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# ─── Sesión ────────────────────────────────────────────────────────────
SESSION_LIFETIME=120
# Sin esto la cookie viaja también por HTTP.
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=<dominio-del-cliente>

# ─── Correo ────────────────────────────────────────────────────────────
# NO dejar `log`. Con `log`, el aviso de que el respaldo falló se escribe en
# un archivo que nadie abre — que es igual a no avisar.
MAIL_MAILER=smtp
MAIL_HOST=<smtp>
MAIL_PORT=587
MAIL_USERNAME=<usuario>
MAIL_PASSWORD=<contraseña>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=<no-reply@dominio>
MAIL_FROM_NAME="${APP_NAME}"

# ─── Respaldos ─────────────────────────────────────────────────────────
# `local` solo NO es respaldo: si muere el disco se pierden la base y las
# copias al mismo tiempo. Va al menos un destino remoto.
BACKUP_DISKS=local,s3
BACKUP_ARCHIVE_PASSWORD=<contraseña larga>

AWS_ACCESS_KEY_ID=<llave>
AWS_SECRET_ACCESS_KEY=<secreto>
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=<bucket>
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── Alertas ───────────────────────────────────────────────────────────
HEALTH_NOTIFICATIONS=true
HEALTH_ALERT_EMAIL=<un correo que alguien revise TODOS los días>

# ─── El primer usuario ─────────────────────────────────────────────────
# El seeder se niega a correr en production sin contraseña. Que no sea la
# del ejemplo: `olympo:verificar-produccion` comprueba el hash, no el .env.
ADMIN_EMAIL=<correo del cliente>
ADMIN_PASSWORD=<contraseña larga>
ADMIN_NAME="<Nombre>"

# ─── Datos que salen impresos en el recibo ─────────────────────────────
EMISOR_NOMBRE="<Razón social>"
EMISOR_RTN="<RTN>"
EMISOR_RESIDENCIAL="<Nombre del residencial>"
EMISOR_DIRECCION="<Dirección>"
EMISOR_TELEFONO="<Teléfono>"

# ─── Cláusula Séptima: corte por mora del CLIENTE con Olympo ───────────
# Se deja en false. Ponerlo en true corta el panel y los documentos; el
# super-admin sigue entrando para poder exportarle los datos (Cl. Décima).
PRADERAS_SUSPENDIDO=false

# ─── La cartera anterior al sistema ──────────────────────────────────
#
# Acá vivía OLYMPO_PROXIMO_RECIBO. Se fue el 24-ago-2026: el número desde
# el que imprime el sistema se pone POR PROYECTO, en el panel, pestaña
# «Facturación» del desarrollo (`proyectos.proximo_recibo`). Con más de un
# proyecto una variable sola se confundía sola.
#
# Los recibos de la cartera vieja se cargan sin serie y siguen con su
# numeración de seis dígitos; los que imprime el sistema salen con el
# código del proyecto adelante (RPS-00000001).
